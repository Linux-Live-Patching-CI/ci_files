# Merged on top of defconfig and tools/testing/selftests/livepatch/config for
# the kernel the livepatch selftests boot.
#
# The build checks that every option asked for here, and in the selftests
# fragment, made it into the final .config.  Kconfig drops an option whose
# dependencies are not met without a word, and the selftests config asks for
# CONFIG_LIVEPATCH=y, which x86_64 defconfig cannot give it.

# CONFIG_LIVEPATCH depends on DYNAMIC_FTRACE_WITH_{REGS,ARGS}, which is off
# unless the function tracer is on, and defconfig leaves it off.
CONFIG_FUNCTION_TRACER=y

# test-kprobe.sh skips without it, and a skip fails the run.
CONFIG_KPROBES_ON_FTRACE=y

# klp-build's kernel-side requirement, and the configuration this tree exists
# to develop.  It is on by default wherever LIVEPATCH is; listing it makes the
# config check fail if that ever changes, rather than leave CI testing a kernel
# klp-build could not patch.
CONFIG_KLP_BUILD=y

# The detectors behind the splats the guest script fails the run on; without
# them the kernel never reports what its patterns look for.  BPF CI's selftest
# kernels run lockdep, sleep-in-atomic checking and soft-lockup detection on
# the same runners.  KASAN is left out for what it costs in build and run time.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# What vmtest needs to boot a kernel with the runner's root filesystem: 9p
# over virtio for the root, and a virtio console for the guest agent that runs
# the command.  x86_64 defconfig has all of them today; listing them turns a
# defconfig that stops carrying one into a configure error instead of a VM
# that never comes up.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
